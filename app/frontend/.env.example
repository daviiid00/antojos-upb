# Copia este archivo como .env y llena los valores. El .env nunca se sube.
PORT=3000

# Base de datos MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=antojos
DB_PASSWORD= 
DB_NAME=antojos_upb

# Autenticación: JWT_SECRET es obligatorio, mínimo 32 caracteres aleatorios
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Origen permitido por CORS
FRONTEND_URL=http://localhost:5173

# Imágenes: credenciales de la cuenta de Cloudinary del equipo
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=